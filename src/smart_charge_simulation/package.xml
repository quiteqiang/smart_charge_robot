<?xml version="1.0"?>
<package format="3">
  <name>smart_charge_simulation</name>
  <version>0.1.0</version>
  <description>Minimal Nav2-compatible simulator: diff-drive kinematics, ray-cast laser, dynamic obstacles, simulated dock perception.</description>
  <maintainer email="dev@example.com">smart_charge_robot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <!-- 运动学参数单一事实源：解析 smart_charge_base 的 URDF（#8） -->
  <exec_depend>smart_charge_base</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- 可选：numpy 使激光求交走向量化的 fast path；缺省时节点自动回退纯 Python -->
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
